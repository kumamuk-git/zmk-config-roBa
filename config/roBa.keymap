#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        c_bkt {
            bindings = <&m_bkt>;
            key-positions = <19 20>;
        };

        c_par {
            bindings = <&m_par>;
            key-positions = <7 8>;
        };

        c_brc {
            bindings = <&m_brc>;
            key-positions = <31 32>;
        };

        c_dqt {
            bindings = <&m_dqt>;
            key-positions = <18 19>;
        };

        c_sqt {
            bindings = <&m_sqt>;
            key-positions = <6 7>;
        };

        c_grave {
            bindings = <&m_grave>;
            key-positions = <30 31>;
        };

        c_lang1 {
            bindings = <&kp LANG1>;
            key-positions = <18 19 20>;
        };

        c_lang2 {
            bindings = <&kp LANG2>;
            key-positions = <11 12 13>;
        };
    };

    macros {
        m_par: m_par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "m_par";
        };

        m_bkt: m_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "m_bkt";
        };

        m_brc: m_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "m_brc";
        };

        m_dqt: m_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
            label = "m_dqt";
        };

        m_sqt: m_sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "m_sqt";
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp LEFT>;
            label = "m_grave";
        };
    };

    behaviors {
        mo_comma_excl: mo_comma_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_COMMA_EXCL";
            bindings = <&kp COMMA>, <&kp EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_dot_qmark: mo_dot_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_DOT_QMARK";
            bindings = <&kp DOT>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_minus_under: mo_minus_under {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_MINUS_UNDER";
            bindings = <&kp MINUS>, <&kp UNDER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_colon_hash: mo_colon_hash {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_COLON_HASH";
            bindings = <&kp COLON>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_q_esc: td_q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESC>;

            tapping-term-ms = <200>;
        };

        td_lang1_lang2: td_lang1_lang2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANG1_LANG2";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&kp LANG2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        O24 {
            bindings = <
&td_q_esc  &kp L         &kp U         &mo_comma_excl    &mo_dot_qmark                                      &kp F        &kp W              &kp R    &kp Y  &kp P
&kp E      &kp I         &kp A         &mt LEFT_SHIFT O  &mo_minus_under  &kp ESC              &kp LG(TAB)  &kp K        &mt RIGHT_SHIFT T  &lt 5 N  &kp S  &kp H
&kp Z      &kp X         &kp C         &kp V             &mo_colon_hash   &kp LC(LS(ESC))      &kp LG(V)    &kp G        &kp D              &kp M    &kp J  &kp B
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &td_lang1_lang2   &lt 1 SPACE      &lt 2 TAB            &kp BSPC     &lt 3 ENTER                                     &kp CAPS
            >;
        };

        NUM {
            bindings = <
&kp PIPE   &kp DLLR   &kp PRCNT  &kp AMPS   &kp BSLH                           &kp FSLH         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS
&kp AT     &kp CARET  &kp LT     &kp GT     &kp TILDE  &none       &kp KP_NUM  &kp ASTRK        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp SEMI   &none       &none       &kp DOT          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL
&none      &none      &none      &trans     &trans     &trans      &kp DEL     &kp KP_NUMBER_0                                                     &kp ENTER
            >;
        };

        NAV {
            bindings = <
&kp K_MUTE    &kp LC(LG(LEFT))    &kp LG(UP)    &kp LC(LG(RIGHT))    &kp PRINTSCREEN                         &kp RC(F)  &kp HOME       &kp UP     &kp END     &kp RC(X)
&kp C_VOL_UP  &kp LG(LEFT_ARROW)  &kp LG(DOWN)  &kp LG(RIGHT_ARROW)  &kp C_BRI_UP     &trans      &trans     &kp RC(A)  &kp LEFT       &kp DOWN   &kp RIGHT   &kp RC(C)
&kp C_VOL_DN  &kp LA(LEFT)        &kp LG(D)     &kp LA(RIGHT)        &kp C_BRI_DN     &trans      &trans     &kp RC(S)  &kp BACKSPACE  &kp ENTER  &kp DELETE  &kp RC(V)
&trans        &trans              &trans        &trans               &trans           &trans      &kp RCTRL  &kp RSHFT                                        &trans
            >;
        };

        FUNCTION {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &kp F15  &kp F7  &kp F8  &kp F9  &kp F12
&none           &none         &none         &none         &none         &sys_reset       &to 6   &kp F14  &kp F4  &kp F5  &kp F6  &kp F11
&none           &none         &none         &none         &none         &bootloader      &none   &kp F13  &kp F1  &kp F2  &kp F3  &kp F10
&bt BT_CLR_ALL  &bt BT_CLR    &out OUT_TOG  &kp LANG2     &trans        &trans           &trans  &trans                           &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &kp F2          &msc SCRL_UP    &kp F11          &trans                      &kp RC(RS(T))  &mkp MB4         &mkp MB3  &mkp MB5     &kp RC(R)
&trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans      &trans  &kp RC(T)      &mkp MB1         &none     &mkp MB2     &kp RC(F)
&trans  &kp LA(LEFT)    &kp F5          &kp LA(RIGHT)    &trans  &trans      &trans  &kp RC(W)      &kp RC(RS(TAB))  &kp ESC   &kp RC(TAB)  &kp RC(L)
&trans  &trans          &trans          &trans           &trans  &trans      &trans  &trans                                                 &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        game {
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3  &kp N4                               &kp FSLH         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E   &kp R      &kp T      &kp KP_NUM     &kp ASTRK        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS
&kp LEFT_SHIFT  &kp A   &kp S   &kp D   &kp F      &kp G      &to 0          &kp PERIOD       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL
&kp LCTRL       &kp Z   &kp X   &kp C   &kp SPACE  &kp V      &kp BACKSPACE  &kp KP_NUMBER_0                                                     &kp ENTER
            >;
        };
    };
};
